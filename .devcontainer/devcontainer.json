{
    "name": "Jupyter & Apache Zeppelin Codespace",
    // GitHub Codespaces descarga automáticamente este sistema operativo Ubuntu optimizado
    "image": "://microsoft.com",
    "hostRequirements": {
        "cpus": 2
    },
    "workspaceFolder": "/workspace",
    "features": {
        // Codespaces inyecta JDK 21 y sus variables de entorno globales de forma nativa
        "ghcr.io/devcontainers/features/java:1": {
            "version": "21",
            "jdkDistro": "ms"
        },
        // Codespaces inyecta Python y pip automáticamente en el entorno de Ubuntu
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.12",
            "installTools": true
        }
    },
    // Expone el puerto 8080 para que GitHub te dé una URL web segura para entrar a Zeppelin
    "forwardPorts": [
        8080,
        8989
    ],
    "portsAttributes": {
        "8080": {
            "label": "Apache Zeppelin UI",
            "onAutoForward": "openPreview"
        },
        "8989": {
            "label": "Jupyter Notebook UI",
            "onAutoForward": "openPreview"
        }
    },
    // Comandos de instalación: actualiza Ubuntu, instala dependencias de Python y descarga Zeppelin
    "postCreateCommand": "sudo apt-get update && sudo apt-get upgrade -y && pip3 install -r requirements.txt && wget -q https://apache.org && tar -xzf zeppelin-0.11.0-bin-all.tgz && mv zeppelin-0.11.0-bin-all /home/vscode/zeppelin && rm zeppelin-0.11.0-bin-all.tgz",
    // Enciende el servidor de Zeppelin automáticamente cada vez que tu Codespace se reactive
    "postStartCommand": "/home/vscode/zeppelin/bin/zeppelin-daemon.sh start",
    "customizations": {
        "codespaces": {
            "openFiles": []
        },
        "vscode": {
            "extensions": [
                "ms-toolsai.jupyter",
                "ms-python.python",
                "AllenLi1231.zeppelin-vscode"
            ]
        }
    }
}