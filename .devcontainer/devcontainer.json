{
    "name": "Jupyter & Apache Zeppelin Codespace",

    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
    "hostRequirements": {
        "cpus": 2
    },

    "features": {
        "ghcr.io/devcontainers/features/java:1": {
            "version": "21",
            "jdkDistro": "ms"
        },
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.12",
            "installTools": true
        }
    },
    "forwardPorts": [
        8080,
        8989
    ],
    "portsAttributes": {
        "8080": {
            "label": "Apache Zeppelin UI",
            "onAutoForward": "openPreview",
            "visibility": "public" 
        },
        "8989": {
            "label": "Jupyter Notebook UI",
            "onAutoForward": "openPreview",
            "visibility": "public" 
        }
    },
    "waitFor": "onCreateCommand",
    "updateContentCommand": "python3 -m pip install -r requirements.txt && cp ./config/download_zeppelin.sh /home/vscode/ && chmod +x /home/vscode/download_zeppelin.sh && .home/vscode/download_zeppelin.sh ",
    "postStartCommand": "/home/vscode/zeppelin/bin/zeppelin-daemon.sh start",
    "customizations": {
        "codespaces": {
            "openFiles": []
        },
        "vscode": {
            "extensions": [
                "ms-toolsai.jupyter",
                "ms-python.python",
                "AllenLi1231.zeppelin-vscode"
            ]
        }
    }
}
